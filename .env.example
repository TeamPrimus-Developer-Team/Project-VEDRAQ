# VEDRAQ Root Environment Configuration Template
# Copy this file to .env and populate with your actual credentials.
# NEVER commit the actual .env file to Git!

# Groq AI API Key (Optional: Core fallback operates deterministically if absent)
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=20
GROQ_MAX_RETRIES=1

# Map Provider Configuration (Optional)
MAP_PROVIDER=leaflet
CARTO_API_KEY=your_carto_api_key_here

# Core Backend Configuration
VEDRAQ_ML_AUTO_TRAIN=false
