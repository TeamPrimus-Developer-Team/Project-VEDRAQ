# VEDRAQ Environment Configuration
# Copy this file to .env and insert credentials as needed:
# cp .env.example .env

# ─── GDG "CODE FOR COMMUNITIES" CREDENTIALS ───

# Google Earth Engine (GEE)
# Set your GCP Project ID with Earth Engine API enabled:
GEE_PROJECT_ID=""
# Optional Service Account Key JSON path (or leave empty to use 'gcloud auth application-default'):
GEE_SERVICE_ACCOUNT_KEY=""

# Gemini AI (Multimodal Reasoning, Satellite Damage Assessment & Early Warning)
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Meteorological Feeds (Open-Meteo operates without key; OpenWeatherMap optional)
WEATHER_API_KEY=""

# Groq AI API Key (Optional legacy fallback: operates deterministically if absent)
GROQ_API_KEY=""
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=20
GROQ_MAX_RETRIES=1

# Map Provider Configuration (Optional)
MAP_PROVIDER=leaflet
CARTO_API_KEY=""

# Core Backend Configuration
VEDRAQ_ML_AUTO_TRAIN=false
