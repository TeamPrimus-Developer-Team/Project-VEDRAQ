# VEDRAQ Environment Configuration
# Copy this file to .env and insert a Groq API key only when live AI is needed:
# cp .env.example .env

# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=""

# Groq Model to use for Disaster Intelligence Analysis
# Recommended: llama-3.3-70b-versatile (high reasoning quality & fast)
# Alternate: llama-3.1-8b-instant (ultra low latency)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT=20
GROQ_MAX_RETRIES=1

# Map tiles use OpenStreetMap by default. CARTO is optional.
MAP_PROVIDER=leaflet
CARTO_API_KEY=""

# Disabled by default because retraining writes local model artifacts.
VEDRAQ_ML_AUTO_TRAIN=false
